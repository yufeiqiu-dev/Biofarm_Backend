DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/oasis
AUTH_BYPASS=false
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=us-east-2_xxxxxxxxx
# The app client access tokens must have been issued to. Without it the backend
# accepts a token from any app client in the same pool; required under APP_ENV=prod.
COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-2
S3_BUCKET_NAME=your-bucket-name
CLOUDFRONT_URL=https://xxxxxxxxxx.cloudfront.net
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BYPASS=false
# "test" or "live". The backend refuses to start if STRIPE_SECRET_KEY does not
# match: a live key in staging charges real cards, and a test key in production
# takes no money at all. Staging runs test mode with STRIPE_BYPASS=false, so the
# webhook and capture paths are genuinely exercised.
STRIPE_MODE=test

# Optional overrides (defaults shown)
# APP_ENV=dev
# CORS_ORIGINS=["http://localhost:5174"]
